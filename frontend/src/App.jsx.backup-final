import { useState } from "react";

const GREEN = "#087f5b";
const INK = "#173c2c";
const ACCOUNT_KEY = "perago_demo_account";
const PHONE_KEY = "perago_phone";

function go(page, mode = "") {
  const query = mode ? `?mode=${mode}` : "";
  window.location.href = `/${page}.html${query}`;
}

function readAccount() {
  try {
    return JSON.parse(localStorage.getItem(ACCOUNT_KEY) || "null");
  } catch {
    return null;
  }
}

async function hashPin(pin) {
  const result = await crypto.subtle.digest(
    "SHA-256",
    new TextEncoder().encode(pin)
  );

  return Array.from(new Uint8Array(result))
    .map(b => b.toString(16).padStart(2, "0"))
    .join("");
}

function Header({ subtitle }) {
  return (
    <header style={{ textAlign: "center", marginBottom: 22 }}>
      <div style={{
        width: 46, height: 46, margin: "0 auto 8px",
        display: "grid", placeItems: "center",
        borderRadius: 14, background: GREEN,
        color: "#fff", fontSize: 25, fontWeight: 800
      }}>₱</div>
      <div style={{ fontSize: 23, fontWeight: 800 }}>PeraGo</div>
      <div style={{ color: "#718278", fontSize: 12, marginTop: 5 }}>
        {subtitle}
      </div>
    </header>
  );
}

function Button({ children, onClick, secondary = false }) {
  return (
    <button onClick={onClick} style={{
      width: "100%", padding: 13, marginTop: 12,
      border: 0, borderRadius: 12,
      background: secondary ? "#e8f2eb" : GREEN,
      color: secondary ? INK : "#fff",
      fontSize: 14, fontWeight: 700
    }}>{children}</button>
  );
}

function Keypad({ value, onChange, max = 4, onSubmit, buttonText }) {
  function press(key) {
    if (key === "⌫") {
      onChange(value.slice(0, -1));
    } else if (/^\d$/.test(key) && value.length < max) {
      onChange(value + key);
    }
  }

  return (
    <>
      <div style={{
        display: "flex", justifyContent: "center",
        gap: 11, flexWrap: "wrap", margin: "17px 0"
      }}>
        {Array.from({ length: max }, (_, i) => (
          <span key={i} style={{
            width: max > 6 ? 9 : 12,
            height: max > 6 ? 9 : 12,
            borderRadius: "50%",
            background: value.length > i ? GREEN : "#d6e1da"
          }} />
        ))}
      </div>

      <div style={{
        display: "grid", gridTemplateColumns: "repeat(3,1fr)", gap: 8
      }}>
        {["1","2","3","4","5","6","7","8","9","","0","⌫"].map((key, i) => (
          <button key={i} type="button" disabled={!key}
            onClick={() => press(key)} style={{
              height: 45, borderRadius: 11,
              border: "1px solid #e0e9e3",
              background: key ? "#f7faf8" : "transparent",
              color: INK, fontSize: 19, fontWeight: 650
            }}>{key}</button>
        ))}
      </div>

      <Button onClick={onSubmit}>{buttonText}</Button>
    </>
  );
}

export default function App() {
  const page = location.pathname.split("/").pop().replace(".html", "") || "index";
  const mode = new URLSearchParams(location.search).get("mode") || "register";

  const [number, setNumber] = useState(
    () => localStorage.getItem(PHONE_KEY) || ""
  );
  const [otp, setOtp] = useState("");
  const [demoOtp, setDemoOtp] = useState(
    () => sessionStorage.getItem("perago_demo_otp") || ""
  );
  const [pin, setPin] = useState("");
  const [confirmPin, setConfirmPin] = useState("");
  const [message, setMessage] = useState("");
  const [profile, setProfile] = useState({
    name: "", email: "", filipino: "Yes", birthday: ""
  });

  const account = readAccount();

  function saveNumber(value) {
    const digits = value.replace(/\D/g, "").slice(0, 11);
    setNumber(digits);
    localStorage.setItem(PHONE_KEY, digits);
  }

  function notice() {
    return message ? (
      <p role="status" style={{
        padding: 10, borderRadius: 9, background: "#edf7ef",
        color: INK, fontSize: 12, lineHeight: 1.5
      }}>{message}</p>
    ) : null;
  }

  function continueNumber() {
    if (!/^09\d{9}$/.test(number)) {
      setMessage("Ilagay ang valid na 11-digit mobile number.");
      return;
    }

    const code = String(Math.floor(100000 + Math.random() * 900000));
    sessionStorage.setItem("perago_demo_otp", code);
    sessionStorage.setItem("perago_flow_mode", mode);
    setDemoOtp(code);
    go("otp", mode);
  }

  function verifyOtp() {
    const code = sessionStorage.getItem("perago_demo_otp");

    if (!code || otp !== code) {
      setMessage("Mali ang OTP. Subukan ulit.");
      return;
    }

    const saved = readAccount();

    if (saved && saved.number === number) {
      go("index");
    } else {
      go("register");
    }
  }

  async function login() {
    const saved = readAccount();

    if (!/^09\d{9}$/.test(number)) {
      setMessage("Ilagay ang valid na mobile number.");
      return;
    }

    if (!saved || saved.number !== number) {
      setMessage("Walang registered account para sa number na ito.");
      return;
    }

    if (pin.length !== 4 || await hashPin(pin) !== saved.pinHash) {
      setMessage("Mali ang PIN. Subukan ulit.");
      setPin("");
      return;
    }

    sessionStorage.setItem("perago_logged_in", "yes");
    go("dashboard");
  }

  async function createPin() {
    if (!/^\d{4}$/.test(pin) || pin !== confirmPin) {
      setMessage("Dapat 4 digits at magkapareho ang dalawang PIN.");
      return;
    }

    const saved = {
      ...profile,
      number: localStorage.getItem(PHONE_KEY) || number,
      pinHash: await hashPin(pin)
    };

    localStorage.setItem(ACCOUNT_KEY, JSON.stringify(saved));
    sessionStorage.removeItem("perago_demo_otp");
    go("index");
  }

  function logout() {
    sessionStorage.removeItem("perago_logged_in");
    go("index");
  }

  const shell = {
    minHeight: "100dvh", boxSizing: "border-box",
    display: "flex", alignItems: "center", justifyContent: "center",
    padding: 12, background: "#202326", color: "#fff",
    fontFamily: "Arial, sans-serif"
  };

  const card = {
    width: "100%", maxWidth: 360, boxSizing: "border-box",
    padding: 19, borderRadius: 20,
    background: "#fff", color: INK,
    boxShadow: "0 8px 30px #0002"
  };

  const input = {
    width: "100%", boxSizing: "border-box", padding: 11,
    marginTop: 5, border: "1px solid #dce7df",
    borderRadius: 10, fontSize: 14
  };

  if (page === "index") {
    return (
      <main style={shell}>
        <section style={card}>
          <Header subtitle="Login" />

          <button onClick={() => go("change-number", "login")} style={{
            width: "100%", padding: 13, border: 0,
            borderRadius: 12, background: "#1769e8",
            color: "#fff", fontSize: 16, fontWeight: 700
          }}>
            {number || "Enter Mobile Number"}　✎
          </button>

          <p style={{ textAlign: "center", fontSize: 13, marginTop: 22 }}>
            Enter your 4-digit PIN
          </p>

          <Keypad value={pin} onChange={setPin} max={4}
            onSubmit={login} buttonText="Login" />

          {notice()}

          <Button secondary onClick={() => go("change-number", "register")}>
            Register
          </Button>
        </section>
      </main>
    );
  }

  if (page === "change-number") {
    return (
      <main style={shell}>
        <section style={card}>
          <Header subtitle="Mobile Number" />

          <div style={{
            padding: 12, borderRadius: 12,
            background: "#1769e8", color: "#fff",
            textAlign: "center", fontSize: 19, fontWeight: 700
          }}>
            {number || "09XXXXXXXXX"}
          </div>

          <p style={{ textAlign: "center", fontSize: 12 }}>
            Enter your 11-digit mobile number
          </p>

          <Keypad value={number} onChange={saveNumber} max={11}
            onSubmit={continueNumber} buttonText="Continue" />

          <Button secondary onClick={() => go("index")}>Back to Login</Button>

          {notice()}
        </section>
      </main>
    );
  }

  if (page === "otp") {
    return (
      <main style={shell}>
        <section style={card}>
          <Header subtitle="OTP Verification" />

          <button onClick={() => go("change-number", mode)} style={{
            width: "100%", padding: 13, border: 0,
            borderRadius: 12, background: "#1769e8",
            color: "#fff", fontSize: 16, fontWeight: 700
          }}>
            {number}　✎
          </button>

          <p style={{ textAlign: "center", fontSize: 13, marginTop: 20 }}>
            Enter the 6-digit OTP
          </p>

          <Keypad value={otp} onChange={setOtp} max={6}
            onSubmit={verifyOtp} buttonText="Verify OTP" />

          <div style={{
            marginTop: 12, padding: 11, borderRadius: 10,
            background: "#edf7ef", textAlign: "center", fontSize: 13
          }}>
            Demo OTP: <b style={{ letterSpacing: 3 }}>{demoOtp || "------"}</b>
            <p style={{ fontSize: 11 }}>Demo only; walang SMS na ipinadala.</p>
          </div>

          {notice()}
        </section>
      </main>
    );
  }

  if (page === "register") {
    return (
      <main style={shell}>
        <section style={card}>
          <Header subtitle="Personal Registration" />

          <form onSubmit={e => {
            e.preventDefault();

            if (!profile.name.trim() || !profile.email.trim() || !profile.birthday) {
              setMessage("Kumpletuhin ang Name, Email, at Birthday.");
              return;
            }

            if (profile.birthday >= new Date().toISOString().slice(0, 10)) {
              setMessage("Pumili ng birthday sa nakaraan.");
              return;
            }

            go("pin");
          }}>
            <label style={{ fontSize: 13 }}>Full Name
              <input required style={input} value={profile.name}
                onChange={e => setProfile({ ...profile, name: e.target.value })} />
            </label>

            <label style={{ display: "block", marginTop: 12, fontSize: 13 }}>
              Email Address
              <input required type="email" style={input} value={profile.email}
                onChange={e => setProfile({ ...profile, email: e.target.value })} />
            </label>

            <label style={{ display: "block", marginTop: 12, fontSize: 13 }}>
              Mobile Number
              <input readOnly style={{ ...input, background: "#eef2ef" }}
                value={number} />
            </label>

            <label style={{ display: "block", marginTop: 12, fontSize: 13 }}>
              Filipino?
              <select style={input} value={profile.filipino}
                onChange={e => setProfile({ ...profile, filipino: e.target.value })}>
                <option>Yes</option>
                <option>No</option>
              </select>
            </label>

            <label style={{ display: "block", marginTop: 12, fontSize: 13 }}>
              Birthday
              <input required type="date"
                max={new Date().toISOString().slice(0, 10)}
                style={input} value={profile.birthday}
                onChange={e => setProfile({ ...profile, birthday: e.target.value })} />
            </label>

            <Button>Done</Button>
          </form>

          {notice()}
        </section>
      </main>
    );
  }

  if (page === "pin") {
    return (
      <main style={shell}>
        <section style={card}>
          <Header subtitle="Create PIN" />

          <p style={{ fontSize: 13 }}>Create a 4-digit PIN</p>
          <Keypad value={pin} onChange={setPin} max={4}
            onSubmit={() => setMessage(pin.length === 4 ? "" : "Ilagay ang 4 digits.")}
            buttonText="Enter PIN" />

          <p style={{ fontSize: 13, marginTop: 18 }}>Confirm PIN</p>
          <Keypad value={confirmPin} onChange={setConfirmPin} max={4}
            onSubmit={createPin} buttonText="Save PIN" />

          {notice()}
        </section>
      </main>
    );
  }

  if (page === "dashboard") {
    if (sessionStorage.getItem("perago_logged_in") !== "yes") {
      return (
        <main style={shell}>
          <section style={card}>
            <Header subtitle="Login Required" />
            <Button onClick={() => go("index")}>Go to Login</Button>
          </section>
        </main>
      );
    }

    return (
      <main style={shell}>
        <section style={card}>
          <Header subtitle="Dashboard" />
          <h2>Kumusta, {account?.name || "User"}!</h2>
          <p>Welcome sa PeraGo.</p>
          <div style={{
            padding: 14, borderRadius: 12,
            background: "#edf7ef", fontSize: 13
          }}>
            <b>Account Details</b>
            <p>Number: {account?.number}</p>
            <p>Email: {account?.email}</p>
          </div>
          <Button onClick={logout}>Log out</Button>
        </section>
      </main>
    );
  }

  return (
    <main style={shell}>
      <section style={card}>
        <Header subtitle="PeraGo" />
        <Button onClick={() => go("index")}>Back to Login</Button>
      </section>
    </main>
  );
}
